@startuml
!include C4_Container.puml

AddElementTag("microService", $shape=EightSidedShape(), $bgColor="CornflowerBlue", $fontColor="white", $legendText="micro service\neight sided")
AddElementTag("storage", $shape=RoundedBoxShape(), $bgColor="lightSkyBlue", $fontColor="white")

LAYOUT_TOP_DOWN()
' LAYOUT_AS_SKETCH()
LAYOUT_WITH_LEGEND()

title Warmhouse Container DiagramBorderColor
Person(customer, Customer, "Пользователь сервиса")

System_Boundary(house, "Дом") {
    System_Ext(sensor_heating, "Heat Sensor", "Сенсор температуры")
    System_Ext(sensor_lighting, "Lighting Sensor", "Сенсор систем освещения")
    System_Ext(sensor_door, "Door Sensor", "Сенсор дверей")

    System_Ext(controller_heating, "Heating Controller", "Умное устройство")
    System_Ext(controller_lighting, "Lighting Controller", "Умное устройство")
    System_Ext(controller_door, "Door Controller", "Умное устройство")
}

System_Boundary(warmhouse, "Warm House") {
    Container(app_web, "Web Application", "Angular", "Веб приложение")
    Container(app_mobile, "Mobile Application", "Android/IOS", "Мобильное приложение")

    Container(service_panel, "Widget Service", "Python", "Микросервис панели управления устройствами. Содержит в себе бизнес логику работы с устройствами.", $tags = "microService")
    Container(service_controller, "Controller Service", "Go", "Отправляет команды на умные устройства", $tags = "microService")
    Container(service_users, "User Service", "Python", "Микросервис пользователей", $tags = "microService")

    Container(service_reciever_heating, "Reciever Service", "Go", "Валидирует и сохраняет данные сенсоров", $tags = "microService")
    Container(service_reciever_lighting, "Reciever Service", "Go", "Валидирует и сохраняет данные сенсоров", $tags = "microService")
    Container(service_reciever_door, "Reciever Service", "Go", "Валидирует и сохраняет данные сенсоров", $tags = "microService")
    
    ContainerDb(database_reciever, "Database Cluster", "", "База данных показаний устройств", $tags = "storage")
    
    ContainerDb(database_users, "Database Cluster", "Postgres", "База данных пользователей", $tags = "storage")
    Container(queue_commands, "Message Broker", "Kafka", "Брокер сообщений с коммандами для устройств. Команды для для разных типов устройств хранятся в разных топиках.", $tags = "storage")
}

Rel(app_web, service_users, "")
Rel(app_web, service_panel, "")
Rel(app_mobile, service_users, "")
Rel(app_mobile, service_panel, "")

Rel_Back(controller_heating, service_controller, "Комманда")
Rel_Back(controller_lighting, service_controller, "Комманда")
Rel_Back(controller_door, service_controller, "Комманда")

Rel(customer, app_web, "")
Rel(customer, app_mobile, "")

Rel(sensor_heating, service_reciever_heating, "Данные")
Rel(sensor_lighting, service_reciever_lighting, "Данные")
Rel(sensor_door, service_reciever_door, "Данные")

Rel(service_reciever_heating, database_reciever, "Запись")
Rel(service_reciever_lighting, database_reciever, "Запись")
Rel(service_reciever_door, database_reciever, "Запись")

Rel(service_panel, queue_commands, "Сообщение-Команда")
Rel(queue_commands, service_controller, "Сообщение-Команда")

Rel(service_users, database_users, "")
Rel(service_panel, database_reciever, "Чтение")
@enduml
